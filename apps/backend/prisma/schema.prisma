// Embroidery Business Management System (EBMS)
// Prisma Schema — Baseline Database Design (Developer Kit v1.0)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum JobStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum JobItemProductionStatus {
  DRAFT
  PENDING_PRODUCTION
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  role               Role      @default(OPERATOR)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdBy          String?   @map("created_by") @db.Uuid
  createdByUser      User?     @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  customerCode    String       @unique @map("customer_code")
  customerType    CustomerType @default(INDIVIDUAL) @map("customer_type")
  name            String
  contactPerson   String?      @map("contact_person")
  mobile          String?
  alternateMobile String?      @map("alternate_mobile")
  email           String?
  address         String?
  notes           String?
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  jobs            Job[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([customerCode])
  @@index([name])
  @@index([mobile])
  @@index([email])
  @@index([deletedAt])
  @@map("customers")
}

model Design {
  id              String    @id @default(uuid()) @db.Uuid
  designCode      String    @unique @map("design_code")
  name            String
  description     String?
  category        String?
  previewUrl      String?   @map("preview_url")
  primaryFileUrl  String?   @map("primary_file_url")
  primaryFileType String?   @map("primary_file_type")
  stitchCount     Int?      @map("stitch_count")
  widthMm         Float?    @map("width_mm")
  heightMm        Float?    @map("height_mm")
  colorCount      Int?      @map("color_count")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  jobItems        JobItem[]

  @@index([designCode])
  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@map("designs")
}

model Job {
  id                   String        @id @default(uuid()) @db.Uuid
  jobNo                String        @unique @map("job_no")
  customerId           String        @map("customer_id") @db.Uuid
  customer             Customer      @relation(fields: [customerId], references: [id])
  jobDate              DateTime      @default(now()) @map("job_date") @db.Timestamptz
  expectedDeliveryDate DateTime?     @map("expected_delivery_date") @db.Timestamptz
  priority             Priority      @default(NORMAL)
  status               JobStatus     @default(DRAFT)
  assignedOperator     String?       @map("assigned_operator")
  startedAt            DateTime?     @map("started_at") @db.Timestamptz
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz
  qualityCheckedAt     DateTime?     @map("quality_checked_at") @db.Timestamptz
  qualityCheckedBy     String?       @map("quality_checked_by")
  deliveredAt          DateTime?     @map("delivered_at") @db.Timestamptz
  notes                String?
  createdBy            String?       @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz
  items                JobItem[]
  invoiceItems         InvoiceItem[]

  @@index([jobNo])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedOperator])
  @@index([deletedAt])
  @@map("jobs")
}

model JobItem {
  id               String                  @id @default(uuid()) @db.Uuid
  jobId            String                  @map("job_id") @db.Uuid
  job              Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  designId         String?                 @map("design_id") @db.Uuid
  design           Design?                 @relation(fields: [designId], references: [id])
  position         String
  quantity         Int
  rate             Float
  lineTotal        Float                   @map("line_total")
  threadColor      String?                 @map("thread_color")
  dimensions       String?
  remarks          String?
  productionStatus JobItemProductionStatus @default(DRAFT) @map("production_status")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  invoiceItems     InvoiceItem[]

  @@index([jobId])
  @@index([designId])
  @@index([productionStatus])
  @@map("job_items")
}

model Invoice {
  id                  String              @id @default(uuid()) @db.Uuid
  invoiceNo           String              @unique @map("invoice_no")
  customerId          String              @map("customer_id") @db.Uuid
  customer            Customer            @relation(fields: [customerId], references: [id])
  invoiceDate         DateTime            @default(now()) @map("invoice_date") @db.Timestamptz
  dueDate             DateTime?           @map("due_date") @db.Timestamptz
  status              InvoiceStatus       @default(DRAFT)
  discountType        DiscountType?       @map("discount_type")
  discountValue       Float?              @map("discount_value")
  discountAmount      Float               @default(0.0) @map("discount_amount")
  subtotal            Float               @default(0.0)
  grandTotal          Float               @default(0.0) @map("grand_total")
  totalPaid           Float               @default(0.0) @map("total_paid")
  outstandingBalance  Float               @default(0.0) @map("outstanding_balance")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  items               InvoiceItem[]
  allocations         PaymentAllocation[]

  @@index([invoiceNo])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceJobId       String?  @map("source_job_id") @db.Uuid
  sourceJob         Job?     @relation(fields: [sourceJobId], references: [id])
  sourceJobItemRef  String?  @map("source_job_item_ref") @db.Uuid
  sourceJobItem     JobItem? @relation(fields: [sourceJobItemRef], references: [id])
  description       String
  quantity          Int
  rate              Float
  amount            Float
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([invoiceId])
  @@index([sourceJobId])
  @@index([sourceJobItemRef])
  @@map("invoice_items")
}

model Payment {
  id            String              @id @default(uuid()) @db.Uuid
  paymentNo     String              @unique @map("payment_no")
  customerId    String              @map("customer_id") @db.Uuid
  customer      Customer            @relation(fields: [customerId], references: [id])
  paymentDate   DateTime            @default(now()) @map("payment_date") @db.Timestamptz
  paymentMethod PaymentMethod       @map("payment_method")
  referenceNo   String?             @map("reference_no")
  amount        Float
  status        PaymentStatus       @default(DRAFT)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  allocations   PaymentAllocation[]

  @@index([paymentNo])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String   @map("invoice_id") @db.Uuid
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  allocatedAmount Float    @map("allocated_amount")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model BusinessConfig {
  id                       String   @id @default(uuid()) @db.Uuid
  companyName              String   @default("EMBROIDERY BUSINESS") @map("company_name")
  logoUrl                  String?  @map("logo_url")
  gstin                    String?  @default("24AAAAA0000A1Z5")
  pan                      String?
  address                  String?  @default("Ring Road, Surat, Gujarat - 395002, India")
  mobile                   String?  @default("+91 98765 43210")
  email                    String?  @default("info@embroidery.com")
  website                  String?  @default("https://embroidery-management.com")
  bankName                 String?  @default("HDFC Bank, Surat Branch") @map("bank_name")
  accountNo                String?  @default("50200012345678") @map("account_no")
  ifscCode                 String?  @default("HDFC0000123") @map("ifsc_code")
  upiId                    String?  @default("embroidery@upi") @map("upi_id")
  upiQrUrl                 String?  @map("upi_qr_url")
  invoiceFooter            String?  @default("Payment due within 15 days of invoice date. Thank you for your business.") @map("invoice_footer")
  jobPrefix                String   @default("JOB-") @map("job_prefix")
  invoicePrefix            String   @default("INV-") @map("invoice_prefix")
  paymentPrefix            String   @default("PAY-") @map("payment_prefix")
  defaultTaxRatePercentage Float    @default(18.0) @map("default_tax_rate_percentage")
  defaultPaymentTermsDays  Int      @default(15) @map("default_payment_terms_days")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("business_config")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  userName      String   @map("user_name")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  reason        String?
  timestamp     DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
}

model DocumentCounter {
  entityType   String   @map("entity_type")
  year         Int
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([entityType, year])
  @@map("document_counters")
}
