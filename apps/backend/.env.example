# EBMS Backend Environment Variable Template
# Copy this file to .env and configure secret keys for your environment.

PORT=3000
NODE_ENV=development
IS_DEMO_MODE=false

# PostgreSQL Database Connection URL (Supabase / Render / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ebms_db?schema=public"

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="replace-with-a-secure-32-character-access-secret-key"
JWT_REFRESH_SECRET="replace-with-a-secure-32-character-refresh-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Origin Allowed Origins (Comma-separated or exact Vercel frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Password Hashing Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Optional Sentry Monitoring DSN
# SENTRY_DSN="https://xxxxxx@sentry.io/xxxxxx"
