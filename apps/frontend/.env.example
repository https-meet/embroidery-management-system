# EBMS Frontend Environment Variable Template
# Copy this file to .env or configure in Vercel Dashboard.

# API Base URL pointing to Express Backend
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Environment Mode (development, demo, production)
VITE_ENV_MODE="development"

# Optional Public Demo Banner Toggle
VITE_ENABLE_DEMO_BANNER="false"

# Optional Sentry Telemetry DSN
# VITE_SENTRY_DSN="https://xxxxxx@sentry.io/xxxxxx"
