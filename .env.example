# -------------------------------------------------------------------
# Embroidery Business Management System (EBMS)
# Example environment configuration.
#
# Copy the required variables into:
# - apps/backend/.env
# - apps/frontend/.env (if needed)
#
# Never commit real .env files.
# -------------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ebms?schema=public"

# Authentication / JWT Configuration
JWT_ACCESS_SECRET="default-ebms-access-secret-key-change-in-production"
JWT_REFRESH_SECRET="default-ebms-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Security Configuration
BCRYPT_SALT_ROUNDS=10

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:3000/api/v1"
