{
  "name": "ebms",
  "version": "1.0.0",
  "private": true,
  "description": "Embroidery Business Management System",
  "scripts": {
    "dev:backend": "pnpm --filter @ebms/backend dev",
    "dev:frontend": "pnpm --filter @ebms/frontend dev",
    "build": "pnpm --filter @ebms/backend build && pnpm --filter @ebms/frontend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
