{
  "name": "ebms",
  "version": "1.0.0",
  "private": true,
  "description": "Embroidery Business Management System",
  "scripts": {
    "dev:backend": "pnpm --filter @ebms/backend dev",
    "dev:frontend": "pnpm --filter @ebms/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^9.28.0",
    "typescript-eslint": "^8.34.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3"
  }
}
